rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isChatMember(chatId) {
      // Check if user is signed in before checking auth.uid
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    
    function isChatOwner(chatId) {
      return isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && !('username' in request.writeFields); // Cannot change username
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if true; // Allow checking for username availability before signup
      allow list: if false;
      allow create: if !exists(/databases/$(database)/documents/usernames/$(username)) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      // allow reading single doc and updating it if member
      allow get: if isChatMember(chatId);
      allow update: if isChatOwner(chatId);

      // allow querying chats collection if the query filters for the user's membership
      allow list: if isSignedIn() && request.auth.uid in resource.data.members;

      allow create: if isSignedIn() && 
                     request.auth.uid in request.resource.data.members &&
                     (request.resource.data.type == 'dm' || request.resource.data.ownerId == request.auth.uid);
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isChatMember(chatId);
      allow create: if isChatMember(chatId) && isOwner(request.resource.data.senderId) &&
                     (get(/databases/$(database)/documents/chats/$(chatId)).data.type != 'channel' || isChatOwner(chatId));
      allow update, delete: if false;
    }
  }
}
