rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == '@Infinite'; }
    
    match /videoChunks/{chunkId} { allow create, read: if isSignedIn(); allow delete: if isAdmin(); }
    match /musicChunks/{chunkId} { allow create, read: if isSignedIn(); }
    match /fileChunks/{chunkId} { allow create, read: if isSignedIn(); }
    match /voiceChunks/{chunkId} { allow create, read: if isSignedIn(); }
    match /circleChunks/{chunkId} { allow create, read: if isSignedIn(); }
    match /apkChunks/{chunkId} { allow read: if true; allow create, delete: if isAdmin(); }
    
    match /users/{userId} {
      allow read: if true;
      allow list: if isAdmin();
      allow create: if request.auth.uid == userId || (isSignedIn() && request.resource.data.isBot == true);
      allow update: if isAdmin() || request.auth.uid == userId || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['infGoldBalance', 'subscriptionTier', 'status', 'lastSeen', 'activeSessionId', 'isBetaTester', 'watchLater', 'subscriptions', 'subscriberCount', 'storyExpirationDuration', 'showPremBadge']));
      allow delete: if request.auth.uid == userId || isAdmin();
    }
    
    match /chats/{chatId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
      match /messages/{messageId} { allow read, write: if isSignedIn(); }
    }

    match /videos/{videoId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
      match /comments/{commentId} { allow read, write: if isSignedIn(); }
    }
    
    match /info/ver { allow get: if true; allow write: if isAdmin(); }
    match /usernames/{username} { allow get: if true; allow create, delete: if isSignedIn(); }
    match /chatLinks/{linkId} { allow get: if true; allow create, delete: if isSignedIn(); }
    match /botLinks/{linkId} { allow get: if true; allow create, delete: if isSignedIn(); }
    match /customBots/{botId} { allow read, write, list: if isSignedIn(); match /userStates/{userId} { allow read, write: if isSignedIn(); } }
    match /stories/{storyId} { allow read, write, list: if isSignedIn(); }
    match /transfers/{transferId} { allow read, create, list: if isSignedIn(); }
  }
}
