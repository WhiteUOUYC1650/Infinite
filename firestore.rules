rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && !('username' in request.writeFields); // Cannot change username
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if true; // Allow checking for username availability before signup
      allow list: if false;
      allow create: if !exists(/databases/$(database)/documents/usernames/$(username)) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      // Allow reading a chat if the user is a member.
      // This applies to both `get` (single doc) and `list` (queries).
      // Firestore will enforce that any query on this collection
      // includes a `where('members', 'array-contains', request.auth.uid)` clause.
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;

      // Allow owner to update anything.
      // Allow member to only update the lastMessage field.
      allow update: if (isSignedIn() && request.auth.uid == resource.data.ownerId) || 
                     (isSignedIn() && request.auth.uid in resource.data.members && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage']));

      allow create: if isSignedIn() && 
                     request.auth.uid in request.resource.data.members &&
                     (request.resource.data.type == 'dm' || request.resource.data.ownerId == request.auth.uid);
    }

    match /chats/{chatId}/messages/{messageId} {
      // To read messages, user must be a member of the parent chat.
      allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      
      // A user can create a message if:
      // 1. They are signed in and are the sender.
      // 2. They are a member of the chat.
      // 3. If it's a channel, they must also be the owner.
      allow create: if isSignedIn() && 
                     request.resource.data.senderId == request.auth.uid && 
                     request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members &&
                     (get(/databases/$(database)/documents/chats/$(chatId)).data.type != 'channel' || request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId);
                     
      allow update, delete: if false;
    }

    match /chatLinks/{linkId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn(); // Relies on client transaction
      allow update, delete: if false;
    }
  }
}
