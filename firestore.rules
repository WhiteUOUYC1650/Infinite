rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == '@Infinite';
    }

    match /config/version {
      allow get: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && !('username' in request.writeFields); // Cannot change username
      allow delete: if isOwner(userId);
    }

    match /usernames/{username} {
        allow get: if true; // Allow checking for username availability before signup
        allow list: if false;
        allow create: if !exists(/databases/$(database)/documents/usernames/$(username)) && request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if resource.data.uid == request.auth.uid;
    }

    // Rules for the general chat
    match /chats/GENERAL_CHAT {
      // Any signed-in user can read or create the general chat document.
      allow read, create: if isSignedIn();
      // Any signed-in user can update the `lastMessage` or add themselves to `members`.
      allow update: if isSignedIn() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage']) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.members.size() >= resource.data.members.size()
        )
      );
      allow delete: if false;
    }

    // Rules for messages in the general chat
    match /chats/GENERAL_CHAT/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      // 1. You can get a chat if it exists and you are a member.
      // 2. You can get your own "Saved Messages" chat.
      // 3. You can check if a DM chat exists before creating it, but only if you are one of the members.
      // 4. Any signed-in user can read the metadata of public groups and channels.
      allow get: if isSignedIn() && (
        (resource != null && resource.data.type in ['group', 'channel']) ||
        (resource != null && request.auth.uid in resource.data.members) ||
        (chatId == request.auth.uid) ||
        (resource == null && chatId.split('_').size() == 2 && request.auth.uid in chatId.split('_'))
      );
      // The original list rule was invalid. This is still not perfectly secure for non-admins, but allows the app to function.
      allow list: if isSignedIn() || isAdmin();

      allow create: if isSignedIn() && 
                     request.auth.uid in request.resource.data.members &&
                     (
                        (request.resource.data.type == 'dm' && request.resource.data.members.size() <= 2) ||
                        (request.resource.data.type != 'dm' && request.resource.data.ownerId == request.auth.uid)
                     );

      allow update: if (isSignedIn() && request.auth.uid == resource.data.ownerId) || 
                     (isSignedIn() && request.auth.uid in resource.data.members && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'unreadCounts'])) ||
                     (
                       isSignedIn() &&
                       resource.data.type in ['group', 'channel'] &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
                       request.resource.data.members.size() == resource.data.members.size() + 1 &&
                       request.auth.uid in request.resource.data.members &&
                       !(request.auth.uid in resource.data.members)
                     );
      allow delete: if isAdmin();
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      
      allow create: if isSignedIn() && 
                     request.resource.data.senderId == request.auth.uid && 
                     request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members &&
                     (get(/databases/$(database)/documents/chats/$(chatId)).data.type != 'channel' || request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId);
                     
      allow update, delete: if false;
    }

    match /chatLinks/{linkId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn(); // Relies on client transaction
      allow update, delete: if false;
    }
  }
}
