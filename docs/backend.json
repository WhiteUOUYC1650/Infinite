
{
  "entities": {
    "AppConfig": {
        "title": "App Config",
        "description": "Stores global application configuration.",
        "type": "object",
        "properties": {
            "latest": {
                "type": "string",
                "description": "The latest available version of the app (e.g., '0.2')."
            }
        },
        "required": ["latest"]
    },
    "User": {
      "title": "User",
      "description": "Represents a user in the system.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "username": { "type": "string" },
        "avatar": { "type": "string" },
        "bannerUrl": { "type": "string", "description": "Profile header banner image." },
        "profileMusicId": { "type": "string", "description": "ID of music track for profile." },
        "status": { "type": "string", "enum": ["online", "away", "offline"] },
        "statusMessage": { "type": "string" },
        "hasSetNickname": { "type": "boolean" },
        "isBot": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "lastSeen": { "type": "object" },
        "infGoldBalance": { "type": "number" },
        "subscriptionTier": { "type": "string" },
        "archivedChats": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name", "username", "avatar", "status"]
    },
    "StickerPack": {
        "title": "Sticker Pack",
        "description": "A collection of stickers created by a user.",
        "type": "object",
        "properties": {
            "name": { "type": "string" },
            "ownerId": { "type": "string" },
            "stickers": { 
                "type": "array", 
                "items": { 
                    "type": "object",
                    "properties": {
                        "id": { "type": "string" },
                        "url": { "type": "string" },
                        "emoji": { "type": "string" }
                    }
                }
            }
        },
        "required": ["name", "ownerId"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/config/version": { "schema": { "$ref": "#/backend/entities/AppConfig" }, "description": "Global config" },
    "/users/{userId}": { "schema": { "$ref": "#/backend/entities/User" }, "description": "User profiles" },
    "/stickerPacks/{packId}": { "schema": { "$ref": "#/backend/entities/StickerPack" }, "description": "Custom user stickers" }
  }
}
