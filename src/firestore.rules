rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Use getAfter() for write operations to prevent read-after-write errors in transactions.
      // For read operations, this will behave like get().
      return isSignedIn() && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == '@Infinite';
    }

    // This rule is for collection group queries on 'messages'.
    // It allows an admin to read from the 'messages' collection group,
    // which is required for the AI report feature to analyze messages across all chats.
    // This rule does not grant write permissions and does not affect non-admin users.
    match /{path=**}/messages/{messageId} {
        allow read: if isAdmin();
    }
    
    match /calls/{callId} {
      // Allow read/write if the user's ID is one of the two in the callId, which is formatted as uid1_uid2
      allow read, write: if isSignedIn() && request.auth.uid in callId.split('_');
    }

    match /config/version {
      allow get: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if
                      // Admin can update anything
                      isAdmin() ||
                      // Owner can update their own profile...
                      (
                        isOwner(userId) &&
                        (
                          // ...if they are NOT changing their username
                          request.resource.data.username == resource.data.username ||
                          // ...OR if they ARE changing username as part of the specific delete operation
                          (
                            request.resource.data.isDeleted == true &&
                            request.resource.data.username == '@deleted_' + userId
                          )
                        )
                      );
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /usernames/{username} {
        allow get: if true; // Allow checking for username availability before signup
        allow list: if false;
        allow create: if request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if resource.data.uid == request.auth.uid || isAdmin();
    }

    // Rules for the general chat
    match /chats/GENERAL_CHAT {
      // Any signed-in user can read or create the general chat document.
      allow read, create: if isSignedIn();
      // Whitelist update operations: sending messages or updating member list.
      allow update: if isSignedIn() && request.writeFields.every(key => key == 'lastMessage' || key.startsWith('unreadCounts.') || key == 'members');
    }

    // Rules for messages in the general chat
    match /chats/GENERAL_CHAT/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() &&
                     request.auth.uid in get(/databases/$(database)/documents/chats/GENERAL_CHAT).data.members &&
                     'readBy' in request.writeFields && request.writeFields.size() == 1;
      allow delete: if resource.data.senderId == request.auth.uid || isAdmin();
    }

    match /chats/{chatId} {
      // 1. You can get a chat if it exists and you are a member.
      // 2. You can get your own "Saved Messages" chat.
      // 3. You can check if a DM chat exists before creating it, but only if you are one of the members.
      // 4. Any signed-in user can read the metadata of public groups and channels.
      allow get: if isSignedIn() && (
        (resource != null && resource.data.type in ['group', 'channel']) ||
        (resource != null && request.auth.uid in resource.data.members) ||
        (chatId == request.auth.uid) ||
        (resource == null && chatId.split('_').size() == 2 && request.auth.uid in chatId.split('_'))
      );
      // The original list rule was invalid. This is still not perfectly secure for non-admins, but allows the app to function.
      allow list: if isSignedIn() || isAdmin();

      allow create: if isSignedIn() && 
                     request.auth.uid in request.resource.data.members &&
                     (
                        (request.resource.data.type == 'dm' && request.resource.data.members.size() <= 2) ||
                        (request.resource.data.type != 'dm' && request.resource.data.ownerId == request.auth.uid)
                     );

      // A comprehensive whitelist for all valid update operations
      allow update: if isSignedIn() && request.auth.uid in resource.data.members &&
                     (
                        // Case 1: Sending a message or resetting unread count.
                        // Allows updating 'lastMessage' and any number of 'unreadCounts.*' fields, but nothing else.
                        (request.writeFields.size() > 0 && request.writeFields.every(key => key == 'lastMessage' || key.startsWith('unreadCounts.')))
                        ||
                        // Case 2: Joining or leaving a chat (only 'members' field can be updated).
                        request.writeFields.hasOnly(['members'])
                        ||
                        // Case 3: Owner editing chat info.
                        (
                          resource.data.ownerId == request.auth.uid &&
                          request.writeFields.every(key => key in ['name', 'avatar', 'description', 'discussionChatId'])
                        )
                     );

      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members) || isAdmin();
      
      allow create: if isSignedIn() && 
                     request.resource.data.senderId == request.auth.uid && 
                     request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members &&
                     (get(/databases/$(database)/documents/chats/$(chatId)).data.type != 'channel' || request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId);
                     
      allow update: if isSignedIn() &&
                     request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members &&
                     (
                       ('readBy' in request.writeFields && request.writeFields.size() == 1) ||
                       (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'editedAt', 'imageUrl', 'videoInfo']))
                     );
      allow delete: if (resource.data.senderId == request.auth.uid) || isAdmin() || (get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group' && get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid);
    
      match /videoChunks/{chunkId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }

    match /chatLinks/{linkId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn(); // Relies on client transaction
      allow update, delete: if false;
    }

    match /botLinks/{linkId} {
      allow get: if true;
      allow list: if false;
      // Admins can create bot links.
      // A user can create the /B/Infinite link if they are also setting isBot=true in the same transaction.
      allow create: if isAdmin() || (linkId == '%2FB%2FInfinite' && request.resource.data.botId == request.auth.uid && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBot == true);
      allow update, delete: if isAdmin();
    }
  }
}
