
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == '@Infinite';
    }

    // Информация о версии
    match /info/ver {
      allow get: if true;
      allow write: if false;
    }

    match /config/version {
      allow get: if true;
      allow write: if false;
    }

    // Чтение сообщений админом (для модерации)
    match /{path=**}/messages/{messageId} {
        allow read: if isAdmin();
    }
    
    // Звонки и трансляции
    match /calls/{callId} {
      allow read, write: if isSignedIn();
    }

    // Профили пользователей
    match /users/{userId} {
      allow read: if true; 
      allow list: if true; 
      allow create: if isOwner(userId);
      // Разрешаем обновление баланса другим пользователям (для трансферов) и системных полей
      allow update: if isAdmin() || isOwner(userId) || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriberCount', 'subscriptions', 'infGoldBalance', 'subscriptionTier', 'lastDailyBonusClaimed', 'status', 'loginProtectionEnabled', 'isBetaTester', 'storyExpirationDuration', 'current-sessions', 'lastSeen']));
      allow delete: if isOwner(userId) || isAdmin();

      match /private/security {
        allow get: if isOwner(userId);
        allow write: if isOwner(userId) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tempBotCode', 'cloudPassword', 'recoveryCode']));
      }
    }

    // Реестр имен
    match /usernames/{username} {
        allow get: if true;
        allow list: if false;
        allow create: if request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if resource.data.uid == request.auth.uid || isAdmin();
    }

    // Чаты (ЛС, Группы, Каналы)
    match /chats/{chatId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() || (request.resource.data.senderId != null); 
        allow update: if isSignedIn() && (
          request.auth.uid == resource.data.senderId ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'readBy', 'videoStatus', 'musicStatus', 'fileStatus', 'videoChunkIds', 'musicChunkIds', 'fileChunkIds', 'voiceStatus', 'voiceChunkIds', 'circleStatus', 'circleChunkIds', 'editedAt', 'content', 'poll'])
        );
        allow delete: if (resource.data.senderId == request.auth.uid) || isAdmin() || (get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid);
      }
    }
    
    // Истории (Stories)
    match /stories/{storyId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy']);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // InfVid
    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.senderId || isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasAny(['views', 'likedBy', 'videoStatus', 'videoChunkIds']));
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.senderId || isAdmin());

      match /comments/{commentId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy']);
        allow delete: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      }
    }
    
    // Чанки файлов
    match /videoChunks/{chunkId} { allow create, read: if true; }
    match /musicChunks/{chunkId} { allow create, read: if true; }
    match /fileChunks/{chunkId} { allow create, read: if true; }
    match /voiceChunks/{chunkId} { allow create, read: if true; }
    match /circleChunks/{chunkId} { allow create, read: if true; }
    
    // Ссылки
    match /chatLinks/{linkId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn();
    }

    match /botLinks/{linkId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() || (linkId == '%2FB%2FInfinite' && request.resource.data.botId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
