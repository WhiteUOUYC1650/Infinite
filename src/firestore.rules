rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == '@Infinite';
    }

    // This rule is for collection group queries on 'messages'.
    match /{path=**}/messages/{messageId} {
        allow read: if isAdmin();
    }
    
    match /calls/{callId} {
      allow read, write: if isSignedIn() && request.auth.uid in callId.split('_');
    }

    match /config/version {
      allow get: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn(); 
      allow create: if isOwner(userId);
      allow update: if
                      isAdmin() ||
                      (
                        isOwner(userId) &&
                        (
                          request.resource.data.username == resource.data.username ||
                          (
                            request.resource.data.isDeleted == true &&
                            request.resource.data.username == '@deleted_' + userId
                          )
                        )
                      );
      allow delete: if isOwner(userId) || isAdmin();

      // Secure storage for private security data like cloud passwords
      match /private/security {
        allow read, write: if isOwner(userId);
      }
    }

    match /usernames/{username} {
        allow get: if true;
        allow list: if false;
        allow create: if request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if resource.data.uid == request.auth.uid || isAdmin();
    }

    match /chats/{chatId} {
      allow get: if isSignedIn() && (
        (resource != null && resource.data.type in ['group', 'channel']) ||
        (resource != null && request.auth.uid in resource.data.members) ||
        (chatId == request.auth.uid) ||
        (resource == null && chatId.split('_').size() == 2 && request.auth.uid in chatId.split('_'))
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && 
                     request.auth.uid in request.resource.data.members &&
                     (
                        (request.resource.data.type == 'dm' && request.resource.data.members.size() <= 2) ||
                        (request.resource.data.type != 'dm' && request.resource.data.ownerId == request.auth.uid)
                     );
      
      // Allow members to update the chat, and allow non-members to join groups/channels.
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.members ||
        (
          resource.data.type in ['group', 'channel'] &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.auth.uid in request.resource.data.members
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if request.auth.uid == resource.data.senderId;
        allow delete: if (resource.data.senderId == request.auth.uid) || isAdmin() || (get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group' && get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid);
      }
    }
    
    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      // Allow update if owner OR if only the 'views' field is being updated by a viewer
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.senderId || 
        isAdmin() || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
      );
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.senderId || isAdmin());

      // Rules for video comments
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }
    
    match /videoChunks/{chunkId} {
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    match /musicChunks/{chunkId} {
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow read: if isSignedIn();
      allow update, delete: if false;
    }
    
    match /chatLinks/{linkId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /botLinks/{linkId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() || (linkId == '%2FB%2FInfinite' && request.resource.data.botId == request.auth.uid && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBot == true);
      allow update, delete: if isAdmin();
    }
  }
}