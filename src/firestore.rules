rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == '@Infinite';
    }

    match /info/ver {
      allow get: if true;
      allow write: if false;
    }

    match /config/version {
      allow get: if true;
      allow write: if false;
    }

    match /{path=**}/messages/{messageId} {
        allow read: if isAdmin();
    }
    
    match /calls/{callId} {
      allow read, write: if isSignedIn() && request.auth.uid in callId.split('_');
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn(); 
      allow create: if isOwner(userId);
      allow update: if isAdmin() || isOwner(userId) || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriberCount', 'subscriptions', 'infGoldBalance', 'subscriptionTier', 'lastDailyBonusClaimed', 'status']));
      allow delete: if isOwner(userId) || isAdmin();

      match /private/security {
        allow read, write: if isOwner(userId);
      }
    }

    match /usernames/{username} {
        allow get: if true;
        allow list: if false;
        allow create: if request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if resource.data.uid == request.auth.uid || isAdmin();
    }

    match /chats/{chatId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if request.auth.uid == resource.data.senderId;
        allow delete: if (resource.data.senderId == request.auth.uid) || isAdmin() || (get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid);
      }
    }
    
    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.senderId || isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasAny(['views', 'likedBy']));
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.senderId || isAdmin());

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      }
    }
    
    match /videoChunks/{chunkId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
    }

    match /musicChunks/{chunkId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
    }

    match /fileChunks/{chunkId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
    }
    
    match /chatLinks/{linkId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn();
    }

    match /botLinks/{linkId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() || (linkId == '%2FB%2FInfinite' && request.resource.data.botId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
