rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == '@Infinite';
    }

    function isBotOwner(botId) {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(botId)).data.botOwnerId == request.auth.uid;
    }

    function isChatOwner(chatId) {
      return isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid;
    }

    match /info/ver {
      allow get: if true;
      allow write: if isAdmin();
    }

    match /config/version {
      allow get: if true;
      allow write: if false;
    }

    match /{path=**}/messages/{messageId} {
        allow read: if isAdmin();
    }
    
    match /calls/{callId} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if true; 
      allow list: if true; 
      allow create: if isOwner(userId) || (isSignedIn() && request.resource.data.isBot == true && request.resource.data.botOwnerId == request.auth.uid);
      allow update: if isAdmin() || isOwner(userId) || isBotOwner(userId) || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriberCount', 'subscriptions', 'infGoldBalance', 'subscriptionTier', 'lastDailyBonusClaimed', 'status', 'loginProtectionEnabled', 'isBetaTester', 'storyExpirationDuration', 'current-sessions', 'lastSeen', 'showPremBadge', 'activeSessionId']));
      allow delete: if isOwner(userId) || isAdmin() || isBotOwner(userId);

      match /private/security {
        allow get: if isOwner(userId);
        allow write: if isOwner(userId) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tempBotCode', 'cloudPassword', 'recoveryCode']));
      }
    }

    match /usernames/{username} {
        allow get: if true;
        allow list: if isAdmin();
        allow create: if isAdmin() || request.resource.data.uid == request.auth.uid || (isSignedIn() && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.botOwnerId == request.auth.uid);
        allow update: if false;
        allow delete: if isAdmin() || resource.data.uid == request.auth.uid || isBotOwner(resource.data.uid);
    }

    match /chats/{chatId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() || isAdmin();
      allow update: if isAdmin() || isChatOwner(chatId) || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadCounts', 'typingStatus', 'lastMessage', 'members']));
      allow delete: if isAdmin() || isChatOwner(chatId);

      match /messages/{messageId} {
        allow read: if isSignedIn();
        
        allow create: if isAdmin() || (
          isSignedIn() && (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          ) && (
            get(/databases/$(database)/documents/chats/$(chatId)).data.type != 'channel' ||
            get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid
          )
        );
        
        allow update: if isAdmin() || (
          isSignedIn() && (
            request.auth.uid == resource.data.senderId ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'readBy', 'editedAt', 'content'])
          )
        );
        
        allow delete: if isAdmin() || (
          isSignedIn() && (
            get(/databases/$(database)/documents/users/$(resource.data.senderId)).data.username != '@Infinite' && (
              resource.data.senderId == request.auth.uid || 
              get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid ||
              get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'dm'
            )
          )
        );
      }
    }
    
    match /stories/{storyId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy']);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid == request.resource.data.senderId || isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasAny(['views', 'likedBy', 'videoStatus', 'videoChunkIds']));
      allow delete: if isSignedIn() && (request.auth.uid == request.resource.data.senderId || isAdmin());

      match /comments/{commentId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy']);
        allow delete: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      }
    }
    
    match /customBots/{botId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /userStates/{userId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || get(/databases/$(database)/documents/customBots/$(botId)).data.ownerId == request.auth.uid);
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /transfers/{transferId} {
        allow read, list: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
    }
    
    match /videoChunks/{chunkId} { allow create, read: if true; }
    match /musicChunks/{chunkId} { allow create, read: if true; }
    match /fileChunks/{chunkId} { allow create, read: if true; }
    match /voiceChunks/{chunkId} { allow create, read: if true; }
    match /circleChunks/{chunkId} { allow create, read: if true; }
    
    match /apkChunks/{chunkId} { 
      allow read: if true; 
      allow create, delete: if isAdmin();
    }
    
    match /chatLinks/{linkId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.ownerId == request.auth.uid);
    }

    match /botLinks/{linkId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || (isSignedIn() && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.botOwnerId == request.auth.uid);
      allow update, delete: if isAdmin() || (isSignedIn() && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.botOwnerId == request.auth.uid);
    }
  }
}
